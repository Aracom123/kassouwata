# Copier ce fichier en ".env" (même dossier) et renseigner les valeurs.
# Le fichier .env est lu au démarrage (spring.config.import) et n'est jamais versionné.

# Base de données PostgreSQL
DB_PASSWORD=

# Agrégateur de paiement KomiPay
# Base du jeton (/generateToken)
PAYMENT_BASE_URL=https://www.komipay.com/APIs/mobile_money.php
# Base des transactions (b2c_standard, crypt-cvv, check-transaction-status).
# Facultatif : par défaut ${PAYMENT_BASE_URL}/customers-api-kp/v1
# PAYMENT_TRANSACTION_BASE_URL=
PAYMENT_LOGIN=
PAYMENT_PASSWORD=
PAYMENT_API_KEY=
# En-tête "keypass" des paiements par carte
PAYMENT_KEYPASS=

# Développement uniquement : afficher les codes OTP dans la console du backend
# OTP_LOG_CODE=true
